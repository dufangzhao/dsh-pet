{
  "schemaVersion": 1,
  "id": "pet.speech-output",
  "version": "0.1.0",
  "displayName": { "en": "Automatic speech output", "zh-CN": "语音朗读（TTS）" },
  "description": { "en": "Optional, owned Pet playback of the shared Agent's formal replies" },
  "license": "MIT",
  "host": "^1.0.0",
  "platforms": ["linux-x64", "win32-x64"],
  "entries": { "runtime": "dist/index.mjs" },
  "provides": [
    {
      "id": "renderer",
      "capability": "companion.speech.control@1",
      "features": { "methodPermissions": { "describe": [] } }
    }
  ],
  "permissions": [{ "kind": "capability-use", "capability": "companion.speech.control@1" }],
  "config": {
    "version": 1,
    "schema": { "type": "object", "additionalProperties": false, "properties": {} }
  }
}
