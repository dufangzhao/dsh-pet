{
  "schemaVersion": 1,
  "id": "pet.local-agent-link",
  "version": "0.1.0",
  "displayName": { "en": "Agent link for local QQ", "zh-CN": "本地 QQ 的 Agent 连接" },
  "description": {
    "en": "Daemon-owned Agent connection without a local conversation engine",
    "zh-CN": "独立宿主持有的 Agent 连接，不启动本地对话引擎"
  },
  "license": "MIT",
  "host": "^1.0.0",
  "platforms": ["linux-x64", "linux-arm64", "darwin-x64", "darwin-arm64", "win32-x64"],
  "entries": { "runtime": "dist/index.mjs" },
  "provides": [
    {
      "id": "link",
      "capability": "companion.localagent.link@1",
      "features": {
        "methodPermissions": {
          "status": [{ "kind": "files", "scope": "plugin-data", "access": "read" }]
        }
      }
    }
  ],
  "permissions": [
    { "kind": "files", "scope": "plugin-data", "access": "read-write" },
    { "kind": "credentials", "keys": ["local-agent-bearer"] }
  ],
  "config": {
    "version": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "agentId", "agentEpoch"],
      "properties": {
        "baseUrl": { "type": "string", "maxLength": 2048, "default": "" },
        "agentId": { "type": "string", "maxLength": 128, "default": "" },
        "agentEpoch": { "type": "string", "maxLength": 128, "default": "" }
      }
    },
    "apply": { "baseUrl": "immediate", "agentId": "immediate", "agentEpoch": "immediate" }
  }
}
