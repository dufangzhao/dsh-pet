{
  "name": "@pet/text-client",
  "version": "0.1.0",
  "private": true,
  "description": "协议驱动的可替换文字客户端：同源 HTTP/SSE，静态 panel 贡献",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node build.mjs",
    "test": "node --import ./tests/source-loader.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "@pet/contracts": "workspace:*",
    "@pet/plugin-sdk": "workspace:*",
    "@pet/ui-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "catalog:"
  },
  "files": [
    "dist",
    "plugin.json"
  ]
}
