{
  "name": "@pet/text-client",
  "version": "0.1.0",
  "private": true,
  "description": "\u534f\u8bae\u9a71\u52a8\u7684\u53ef\u66ff\u6362\u6587\u5b57\u5ba2\u6237\u7aef\uff1a\u540c\u6e90 HTTP/SSE\uff0c\u9759\u6001 panel \u8d21\u732e",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./model-ui": {
      "types": "./src/model-ui.ts",
      "default": "./src/model-ui.ts"
    },
    "./model.css": "./src/client/model.css",
    "./persona-memory-ui": {
      "types": "./src/persona-memory-ui.ts",
      "default": "./src/persona-memory-ui.ts"
    },
    "./persona-memory.css": "./src/client/persona-memory.css",
    "./voice-input-ui": {
      "types": "./src/voice-input-ui.ts",
      "default": "./src/voice-input-ui.ts"
    },
    "./voice-input.css": "./src/client/voice-input.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node build.mjs",
    "test": "node --import ./tests/source-loader.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "@pet/contracts": "workspace:*",
    "@pet/plugin-sdk": "workspace:*",
    "@pet/ui-kit": "workspace:*",
    "@pet/audio-capture": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "catalog:"
  },
  "files": [
    "dist",
    "plugin.json"
  ]
}
