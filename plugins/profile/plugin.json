{
  "schemaVersion": 1,
  "id": "pet.profile",
  "version": "0.1.0",
  "displayName": { "zh-CN": "桌宠偏好", "en": "Pet preferences" },
  "description": {
    "zh-CN": "人设与桌面外观的统一设置",
    "en": "Shared persona and appearance settings"
  },
  "license": "MIT",
  "host": "^1.0.0",
  "platforms": ["win32-x64"],
  "entries": { "runtime": "dist/index.mjs" },
  "provides": [{ "id": "profile", "capability": "app.profile@1" }],
  "consumes": [{ "capability": "speech.output@1", "optional": true }],
  "permissions": [
    { "kind": "files", "scope": "plugin-data", "access": "read-write" },
    { "kind": "capability-use", "capability": "speech.output@1" }
  ],
  "config": {
    "version": 2,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roam",
        "wake",
        "self",
        "hover",
        "bubbleFontSize",
        "bubbleSpeed",
        "glow",
        "frameRate",
        "snoreSeconds",
        "personaTemplate",
        "personaTemplates",
        "wakePoke",
        "wakePat",
        "wakeThrow",
        "wakeDrop",
        "selfFigure",
        "selfPalette",
        "selfRoam",
        "selfSnore",
        "selfSize",
        "selfBubble",
        "selfFont",
        "selfSound",
        "selfTheme",
        "selfHover",
        "selfUser",
        "doubleClickTyping",
        "statusBubble",
        "saidBubble",
        "hideInFullscreen",
        "rememberPosition",
        "lockFps",
        "soundEnabled",
        "soundMove",
        "soundTouch",
        "soundFace",
        "soundSnore",
        "soundUi",
        "speechEnabled",
        "speechProvider",
        "speechVoice",
        "speechRate",
        "speechVolume",
        "petName",
        "userName",
        "replyLanguage",
        "style",
        "personaPrompt",
        "figure",
        "palette",
        "size",
        "visible",
        "alwaysOnTop",
        "draggable",
        "reducedMotion",
        "voiceEnabled"
      ],
      "properties": {
        "roam": {
          "type": "string",
          "enum": ["free", "calm", "off"],
          "title": "走动",
          "default": "calm"
        },
        "wake": {
          "type": "string",
          "enum": ["none", "poke", "all", "custom"],
          "title": "回应模式",
          "default": "poke"
        },
        "self": {
          "type": "string",
          "enum": ["off", "default", "any", "custom"],
          "title": "自主配置",
          "default": "default"
        },
        "hover": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32,
            "enum": ["chat", "voice", "roam", "theme", "sound", "dress", "hide"]
          },
          "maxItems": 6,
          "uniqueItems": true,
          "title": "悬停按钮",
          "default": ["chat", "voice"]
        },
        "bubbleFontSize": {
          "type": "integer",
          "minimum": 80,
          "maximum": 160,
          "title": "气泡字体百分比",
          "default": 100
        },
        "bubbleSpeed": {
          "type": "integer",
          "minimum": 50,
          "maximum": 200,
          "title": "气泡速度百分比",
          "default": 100
        },
        "glow": { "type": "integer", "minimum": 0, "maximum": 16, "title": "外发光", "default": 0 },
        "frameRate": {
          "type": "string",
          "enum": ["60", "120", "144", "unlimited"],
          "title": "目标帧率",
          "default": "60"
        },
        "snoreSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "title": "呼噜时长",
          "default": 0
        },
        "personaTemplate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "title": "当前人格模板",
          "default": "default"
        },
        "personaTemplates": {
          "type": "array",
          "maxItems": 16,
          "title": "人格模板库",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "prompt", "builtin"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "name": { "type": "string", "minLength": 1, "maxLength": 40 },
              "prompt": { "type": "string", "minLength": 1, "maxLength": 16384 },
              "builtin": { "type": "boolean" }
            }
          },
          "default": [
            {
              "id": "default",
              "name": "默认",
              "prompt": "你是一只温和、清楚表达的桌面伙伴。尊重用户的节奏，只描述已经发生的事情。",
              "builtin": true
            },
            {
              "id": "warm",
              "name": "温柔",
              "prompt": "你是一只安静、体贴的桌面伙伴。用简短自然的话倾听，不夸大承诺。",
              "builtin": true
            },
            {
              "id": "lively",
              "name": "活泼",
              "prompt": "你是一只轻快、有好奇心的桌面伙伴。回应自然，玩笑克制，尊重用户边界。",
              "builtin": true
            },
            {
              "id": "rational",
              "name": "理性",
              "prompt": "你是一只平和、务实的桌面伙伴。先讲结论，区分事实和推测，帮助用户专注。",
              "builtin": true
            }
          ]
        },
        "wakePoke": { "type": "boolean", "title": "wakePoke", "default": true },
        "wakePat": { "type": "boolean", "title": "wakePat", "default": true },
        "wakeThrow": { "type": "boolean", "title": "wakeThrow", "default": false },
        "wakeDrop": { "type": "boolean", "title": "wakeDrop", "default": false },
        "selfFigure": { "type": "boolean", "title": "selfFigure", "default": true },
        "selfPalette": { "type": "boolean", "title": "selfPalette", "default": true },
        "selfRoam": { "type": "boolean", "title": "selfRoam", "default": true },
        "selfSnore": { "type": "boolean", "title": "selfSnore", "default": true },
        "selfSize": { "type": "boolean", "title": "selfSize", "default": false },
        "selfBubble": { "type": "boolean", "title": "selfBubble", "default": false },
        "selfFont": { "type": "boolean", "title": "selfFont", "default": false },
        "selfSound": { "type": "boolean", "title": "selfSound", "default": false },
        "selfTheme": { "type": "boolean", "title": "selfTheme", "default": false },
        "selfHover": { "type": "boolean", "title": "selfHover", "default": false },
        "selfUser": { "type": "boolean", "title": "selfUser", "default": false },
        "doubleClickTyping": { "type": "boolean", "title": "doubleClickTyping", "default": true },
        "statusBubble": { "type": "boolean", "title": "statusBubble", "default": true },
        "saidBubble": { "type": "boolean", "title": "saidBubble", "default": true },
        "hideInFullscreen": { "type": "boolean", "title": "hideInFullscreen", "default": false },
        "rememberPosition": { "type": "boolean", "title": "rememberPosition", "default": true },
        "lockFps": { "type": "boolean", "title": "lockFps", "default": false },
        "soundEnabled": { "type": "boolean", "title": "soundEnabled", "default": true },
        "soundMove": { "type": "boolean", "title": "soundMove", "default": true },
        "soundTouch": { "type": "boolean", "title": "soundTouch", "default": true },
        "soundFace": { "type": "boolean", "title": "soundFace", "default": true },
        "soundSnore": { "type": "boolean", "title": "soundSnore", "default": true },
        "soundUi": { "type": "boolean", "title": "soundUi", "default": true },
        "speechEnabled": { "type": "boolean", "default": true, "title": "说话" },
        "speechProvider": {
          "type": ["object", "null"],
          "title": "语音输出提供者",
          "additionalProperties": false,
          "required": ["pluginId", "instanceId", "providerId"],
          "properties": {
            "pluginId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "instanceId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "providerId": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "default": {
            "pluginId": "pet.system-tts",
            "instanceId": "default",
            "providerId": "system"
          }
        },
        "speechVoice": {
          "type": ["string", "null"],
          "maxLength": 256,
          "default": null,
          "title": "声线"
        },
        "speechRate": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10,
          "default": 0,
          "title": "语速"
        },
        "speechVolume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 85,
          "title": "说话音量"
        },
        "petName": {
          "type": "string",
          "title": "桌宠名字",
          "minLength": 1,
          "maxLength": 40,
          "default": "小蓝"
        },
        "userName": {
          "type": "string",
          "title": "称呼你",
          "minLength": 1,
          "maxLength": 40,
          "default": "你"
        },
        "replyLanguage": {
          "type": "string",
          "title": "回复语言",
          "enum": ["zh-CN", "en"],
          "default": "zh-CN"
        },
        "style": {
          "type": "string",
          "title": "表达方式",
          "enum": ["quiet", "natural", "lively"],
          "default": "natural"
        },
        "personaPrompt": {
          "type": "string",
          "title": "完整人设提示词",
          "minLength": 1,
          "maxLength": 16384,
          "default": "You are a desktop companion. Be attentive, clear and useful. Respond through the available pet tools. Describe only actions that actually succeeded. Ask for missing information when necessary. Respect the human choices and permissions."
        },
        "figure": {
          "type": "string",
          "title": "形象",
          "enum": ["minimal", "round"],
          "default": "minimal"
        },
        "palette": {
          "type": "string",
          "title": "配色",
          "enum": ["morning", "lavender", "pine", "orange"],
          "default": "morning"
        },
        "size": {
          "type": "string",
          "title": "大小",
          "enum": ["small", "normal", "large"],
          "default": "normal"
        },
        "visible": { "type": "boolean", "title": "在桌面显示", "default": true },
        "alwaysOnTop": { "type": "boolean", "title": "保持置顶", "default": true },
        "draggable": { "type": "boolean", "title": "允许拖动", "default": true },
        "reducedMotion": { "type": "boolean", "title": "减少动画", "default": false },
        "voiceEnabled": { "type": "boolean", "title": "语音输入", "default": true }
      }
    },
    "apply": { "personaPrompt": "reload" }
  }
}
