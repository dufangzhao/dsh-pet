{
  "name": "@pet/audio-capture",
  "version": "0.1.0",
  "private": true,
  "description": "Owned renderer audio capture and neutral browser/WAV primitives",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./capture-worklet": "./src/capture-worklet.ts",
    "./wave": {
      "types": "./src/pcm-wave.ts",
      "default": "./src/pcm-wave.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@pet/contracts": "workspace:*",
    "@pet/plugin-sdk": "workspace:*"
  }
}
