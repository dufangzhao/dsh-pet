{
  "name": "pet",
  "version": "0.0.0",
  "private": true,
  "description": "AI 桌宠：独立桌面助手，插件化宿主内核与运行时",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter @pet/desktop build",
    "dev": "pnpm --filter @pet/desktop build && pnpm --filter @pet/desktop start",
    "test:qa": "node --test --test-reporter=spec qa/probes/*.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:qa && pnpm lint && pnpm format:check && pnpm build",
    "test:m1:native": "pnpm build && node qa/probes/m1-native-acceptance.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "koffi": "3.3.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sherpa-onnx-node": "1.13.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
