/*
  生成 gallery-data.js：把来源包的实际字节读成经典脚本，file:// 打开时不会被 fetch JSON 的 CORS 挡住。
  用法：node qa/website-style-previews/build-preview.mjs

  来源包 qa/website-style-previews/source-manifest.json + sources/ 由父维护，这一份只读。
  每一族的可演示配方（PANEL/INPUT/BUTTON 那几段标记）按那一族自己的原件标记写：
  改的只有文案、表单名与 id 前缀，材质、层级、类名与动画都留在原件那一套；
  演示里缺什么角色就写缺什么，不替它编一件。
*/
import { createHash } from 'node:crypto';
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const HERE = dirname(fileURLToPath(import.meta.url));
const ROOT = resolve(HERE, '..', '..');
const SITE_UI = join(ROOT, 'apps', 'desktop', 'src', 'renderer', 'console', 'site-ui');
const MANIFEST = join(HERE, 'source-manifest.json');
const LF = String.fromCharCode(10);

function readText(path) {
  try { return readFileSync(path, 'utf8'); } catch (error) { return null; }
}
function digestHex(text) {
  return createHash('sha256').update(text, 'utf8').digest('hex');
}
function extractStyleText(raw) {
  const out = [];
  let cursor = 0;
  for (;;) {
    const start = raw.indexOf('<style', cursor);
    if (start < 0) break;
    const open = raw.indexOf('>', start);
    const close = raw.indexOf('</style>', open);
    if (open < 0 || close < 0) break;
    out.push(raw.slice(open + 1, close));
    cursor = close + 8;
  }
  return out.join(LF);
}
function bodyMarkup(raw) {
  const styleStart = raw.indexOf('<style');
  return (styleStart < 0 ? raw : raw.slice(0, styleStart)).trim();
}
function sliceBetween(raw, startMarker, stopMarker) {
  const s = raw.indexOf(startMarker);
  if (s < 0) return '';
  const e = raw.indexOf(stopMarker, s);
  return e < 0 ? raw.slice(s) : raw.slice(s, e);
}

/**
 * 演示里同一件要摆好几格（三个供应商位、两颗按钮）。
 * 上游有几件用 id 选样式，重复的实例换个带前缀的 id，CSS 里那一条同步改成前缀匹配：
 * 声明一个都不动，只把选择器的写法换掉；原件视图仍按原字节渲染。
 */
function idsInCss(css) {
  const found = {};
  const pattern = /#([A-Za-z][A-Za-z0-9_-]*)/g;
  let match;
  while ((match = pattern.exec(css)) !== null) found[match[1]] = true;
  return Object.keys(found);
}
function prefixIds(css) {
  let out = css;
  for (const id of idsInCss(css)) out = out.split('#' + id).join('[id^="' + id + '"]');
  return out;
}
